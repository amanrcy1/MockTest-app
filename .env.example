# Firebase Configuration
# Get these from Firebase Console → Project Settings → General → Your apps
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# AI Configuration (Optional)
# Get free API key from https://console.groq.com/keys
REACT_APP_GROQ_API_KEY=your_groq_api_key_here

# Groq API key for Vercel serverless function (server-side, NOT prefixed with REACT_APP_)
GROQ_API_KEY=your_groq_api_key_here

# Firebase project ID for serverless function auth verification
FIREBASE_PROJECT_ID=your_project_id

# Allowed CORS origins for API (comma-separated)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Error Tracking (Optional - Production only)
# Get from https://sentry.io
REACT_APP_SENTRY_DSN=your_sentry_dsn_here

# reCAPTCHA (Optional - Production only)
# Get from https://www.google.com/recaptcha/admin
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Environment
NODE_ENV=development
