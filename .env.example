# Firebase client SDK — identifies your app to Firebase (safe to expose in browser)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Domain used for Firebase Auth popups/redirects
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# Your Firebase project identifier
VITE_FIREBASE_PROJECT_ID=your_project_id

# Cloud Storage bucket for file uploads
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Firebase Cloud Messaging sender ID (push notifications)
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Unique ID for this web app in your Firebase project
VITE_FIREBASE_APP_ID=your_app_id

# Override API base URL if hosting backend elsewhere (optional, defaults to /api)
VITE_API_URL=/api

# Groq API key for Vercel serverless functions (server-side only, never sent to browser)
GROQ_API_KEY=your_groq_api_key_here

# Firebase project ID for server-side admin SDK auth verification
FIREBASE_PROJECT_ID=your_project_id

# Firebase service account credentials for server-side admin SDK (optional, enables token verification)
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY=your_service_account_private_key

# Allowed CORS origins for API endpoints (comma-separated)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# reCAPTCHA site key for Firebase App Check (optional, production only)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Sentry DSN for error tracking (optional, production only)
VITE_SENTRY_DSN=your_sentry_dsn_here
